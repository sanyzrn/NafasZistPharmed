---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductIndex from '../components/ProductIndex.astro';
import { digits, makeT, withLocale } from '../i18n/index';
import type { Locale } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
const path = locale === 'fa' ? '/404' : `/${locale}/404`;
---

<Base locale={locale} title={t('notFoundTitle')} description={t('notFoundLead')} path={path}>
  <section class="lost" aria-labelledby="lost-title">
    <canvas class="hero__canvas" data-particles data-text={digits('404', locale)} aria-hidden="true"></canvas>
    <div class="container lost__grid">
      <div class="lost__box hero__box" data-particles-box aria-hidden="true">
        <span class="hero__fallback">{digits('404', locale)}</span>
      </div>
      <div class="lost__copy">
        <h1 class="display-3" id="lost-title">{t('notFoundHeading')}</h1>
        <p class="lead">{t('notFoundLead')}</p>
        <div class="actions">
          <a class="btn btn--primary" href={withLocale('/', locale)}>
            {t('notFoundHome')}
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost" href={withLocale('/contact', locale)}>{t('notFoundContact')}</a>
        </div>
      </div>
    </div>
    <p class="hero__hint" aria-hidden="true">
      <span class="hero__hint-dot"></span>
      <span>{t('notFoundHint')}</span>
    </p>
  </section>

  <section class="section section--surface">
    <div class="container section-body">
      <ProductIndex {locale} headingLevel="h2" />
    </div>
  </section>
</Base>
