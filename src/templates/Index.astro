---
import Base from '../layouts/Base.astro';
import BreathField from '../components/BreathField.astro';
import Icon from '../components/Icon.astro';
import ProductIndex from '../components/ProductIndex.astro';
import SiteForm from '../components/SiteForm.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { news, site } from '../data/site';
import { digits, withLocale, type Locale } from '../i18n/index';
import { makeT } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
const siteData = site(locale);
const newsItems = news(locale);
const year = digits('1398', locale);
const l = (path: string) => withLocale(path, locale);
---

<Base locale={locale} title={t('homeMetaTitle')} description={t('homeMetaDescription')} path="/">
  <HeroSlider {locale} />

  <section class="hero" aria-labelledby="hero-title">
    <BreathField />
    <div class="container hero__inner">
      <h1 class="hero__title" id="hero-title">{siteData.tagline}</h1>
      <p class="hero__lead">{t('homeHeroLead')}</p>
      <div class="actions hero__actions">
        <a class="btn btn--primary" href="#products">
          {t('homeProductsCta')}
          <Icon name="arrow" />
        </a>
        <a class="btn btn--quiet" href={l('/about')}>{t('homeAboutCta')}</a>
      </div>
      <dl class="facts">
        <div class="facts__item">
          <dt class="facts__term">{t('factFounded')}</dt>
          <dd class="facts__value">{year}</dd>
        </div>
        <div class="facts__item">
          <dt class="facts__term">{t('factKnowledgeType')}</dt>
          <dd class="facts__value">{t('factTypeOne')}</dd>
        </div>
        <div class="facts__item">
          <dt class="facts__term">{t('factSpecialty')}</dt>
          <dd class="facts__value"><bdi lang="en">DPI</bdi></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--flush-top" id="products" aria-labelledby="products-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="products-title">{t('productsIndexTitle')}</h2>
        <p class="heading__lead">{t('productsIndexLead')}</p>
      </div>
      <ProductIndex {locale} filter />
    </div>
  </section>

  <section class="section section--air" aria-labelledby="about-title">
    <div class="container split split--center">
      <div class="stack" style="--stack-gap: var(--sp-5)">
        <h2 class="heading__title" id="about-title">{t('homeAboutTitle')}</h2>
        <p class="prose prose--muted">{t('homeAboutLead')}</p>
        <div>
          <a class="link" href={l('/about')}>
            {t('homeAboutLink')}
            <Icon name="arrow" />
          </a>
        </div>
      </div>
      <figure class="media media--wide">
        <img
          src="https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas6-1024x683.jpg"
          alt={t('homeAboutImgAlt')}
          width="1024"
          height="683"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="news-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="news-title">{t('newsTitle')}</h2>
      </div>
      <ul class="news">
        {newsItems.map((n) => (
          <li>
            <a class="news__row" href={n.href} target="_blank" rel="noopener noreferrer">
              <span class="news__thumb">
                <img src={n.image} alt="" width="240" height="180" loading="lazy" decoding="async" />
              </span>
              <span class="news__main">
                <span class="news__date">{n.date}</span>
                <span class="news__title">{n.title}</span>
              </span>
              <span class="news__ext">
                <Icon name="external" label={t('inNewWindow')} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--flush-top" aria-label={t('pathwaysPatientsTitle')}>
    <div class="container pathways">
      <div class="pathways__item">
        <h2 class="pathways__title">{t('pathwaysPatientsTitle')}</h2>
        <p class="pathways__text">{t('pathwaysPatientsText')}</p>
        <a class="btn btn--quiet" href={siteData.patientPortal} target="_blank" rel="noopener noreferrer">
          {t('patientPortalLogin')}
          <Icon name="external" />
        </a>
      </div>
      <div class="pathways__item">
        <h2 class="pathways__title">{t('pathwaysJobsTitle')}</h2>
        <p class="pathways__text">{t('pathwaysJobsText')}</p>
        <a class="btn btn--quiet" href={siteData.jobs} target="_blank" rel="noopener noreferrer">
          {t('viewJobs')}
          <Icon name="external" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--air" aria-labelledby="forms-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="forms-title">{t('formsTitle')}</h2>
        <p class="heading__lead">{t('formsLead')}</p>
      </div>
      <div class="forms">
        <SiteForm {locale} kind="report" headingLevel="h3" />
        <SiteForm {locale} kind="consult" headingLevel="h3" />
      </div>
    </div>
  </section>
</Base>
