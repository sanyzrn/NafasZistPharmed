---
// بنر اسلایدر — تبلیغاتی، زیر هدر
export type Slide = {
  image: string;
  alt?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  href?: string;
  cta?: string;
};

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<section class="slider" aria-roledescription="اسلایدر" aria-label="بنرهای تبلیغاتی">
  <div class="frames" id="slider-frames">
    {slides.map((s, i) => (
      <div
        class="frame"
        data-index={i}
        role="group"
        aria-roledescription="اسلاید"
        aria-label={`اسلاید ${i + 1} از ${slides.length}`}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <img class="frame-img" src={s.image} alt={s.alt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} />

        {(s.title || s.text) && (
          <div class="frame-panel">
            {s.eyebrow && <p class="frame-eyebrow">{s.eyebrow}</p>}
            {s.title && <p class="frame-title">{s.title}</p>}
            {s.text && <p class="frame-text">{s.text}</p>}
            {s.href && s.cta && (
              <a class="btn btn-light frame-cta" href={s.href} target="_blank" rel="noopener noreferrer">{s.cta}</a>
            )}
          </div>
        )}
      </div>
    ))}
  </div>

  <button class="arrow next" type="button" aria-label="اسلاید بعدی">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
  </button>
  <button class="arrow prev" type="button" aria-label="اسلاید قبلی">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
  </button>

  <div class="dots" role="tablist" aria-label="انتخاب اسلاید">
    {slides.map((_, i) => (
      <button
        class:list={['dot', { active: i === 0 }]}
        type="button"
        role="tab"
        aria-label={`اسلاید ${i + 1}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-goto={i}
      ></button>
    ))}
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.slider');
  if (root) {
    const framesEl = root.querySelector<HTMLElement>('#slider-frames');
    const frames = Array.from(root.querySelectorAll<HTMLElement>('.frame'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const next = root.querySelector<HTMLButtonElement>('.arrow.next');
    const prev = root.querySelector<HTMLButtonElement>('.arrow.prev');
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (i: number) => {
      index = (i + frames.length) % frames.length;
      frames.forEach((f, k) => {
        f.classList.toggle('active', k === index);
        f.setAttribute('aria-hidden', k === index ? 'false' : 'true');
      });
      dots.forEach((d, k) => {
        d.classList.toggle('active', k === index);
        d.setAttribute('aria-selected', k === index ? 'true' : 'false');
      });
    };

    const play = () => {
      if (reduced || frames.length < 2) return;
      stop();
      timer = setInterval(() => goTo(index + 1), 6000);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    next?.addEventListener('click', () => { goTo(index + 1); play(); });
    prev?.addEventListener('click', () => { goTo(index - 1); play(); });
    dots.forEach((d) =>
      d.addEventListener('click', () => { goTo(Number(d.dataset.goto)); play(); })
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', play);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', play);

    // keyboard
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { goTo(index + 1); play(); }
      if (e.key === 'ArrowRight') { goTo(index - 1); play(); }
    });

    // touch swipe
    let startX = 0;
    framesEl?.addEventListener(
      'touchstart',
      (e) => { startX = e.touches[0].clientX; stop(); },
      { passive: true }
    );
    framesEl?.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 45) goTo(index + (dx < 0 ? 1 : -1));
        play();
      },
      { passive: true }
    );

    play();
  }
</script>

<style>
  .slider {
    position: relative;
    overflow: hidden;
    background: var(--fog);
    border-bottom: 1px solid var(--line);
  }

  .frames {
    position: relative;
    height: clamp(280px, 46vw, 520px);
  }

  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.65s ease;
  }

  .frame.active {
    opacity: 1;
  }

  .frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .frame-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(1.25rem, 5vw, 4.5rem);
    background: linear-gradient(to right, rgba(31, 31, 29, 0) 35%, rgba(31, 31, 29, 0.6) 68%);
  }

  .frame-eyebrow {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .frame-title {
    color: #fff;
    font-size: clamp(1.35rem, 3.2vw, 2.2rem);
    font-weight: 800;
    line-height: 1.5;
    margin-bottom: 0.4rem;
    text-shadow: 0 1px 14px rgba(31, 31, 29, 0.45);
  }

  .frame-text {
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(0.92rem, 1.5vw, 1.05rem);
    margin-bottom: 1.1rem;
  }

  .frame-cta {
    width: fit-content;
  }

  .arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(31, 31, 29, 0.35);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.15s ease;
    backdrop-filter: blur(4px);
  }

  .arrow:hover {
    background: var(--brand);
    border-color: var(--brand);
  }

  .arrow.next { inset-inline-end: 1rem; }
  .arrow.prev { inset-inline-start: 1rem; }

  .dots {
    position: absolute;
    bottom: 1.1rem;
    inset-inline-start: 50%;
    translate: 50% 0;
    display: flex;
    gap: 0.45rem;
  }

  .dot {
    width: 26px;
    height: 4px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.15s ease, width 0.2s ease;
  }

  .dot.active {
    background: var(--brand);
    width: 38px;
  }

  .dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .arrow { display: none; }

    .frame-panel {
      background: linear-gradient(to top, rgba(31, 31, 29, 0.74) 0%, rgba(31, 31, 29, 0.52) 48%, rgba(31, 31, 29, 0.12) 82%, rgba(31, 31, 29, 0) 100%);
      align-items: flex-start;
      justify-content: flex-end;
      padding-bottom: 3.2rem;
    }
  }
</style>
