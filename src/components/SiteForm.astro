---
/**
 * The three site forms. Markup is identical in structure; only fields and
 * copy differ. Submission is handled by src/scripts/forms.ts. All copy comes
 * from the locale dictionary.
 */
import { products, site } from '../data/site';
import type { Locale } from '../i18n/index';
import { makeT } from '../i18n/index';
import Field from './Field.astro';

interface Props {
  locale: Locale;
  kind: 'report' | 'consult' | 'contact';
  headingLevel?: 'h2' | 'h3';
}

const { locale, kind, headingLevel = 'h2' } = Astro.props;
const t = makeT(locale);
const Heading = headingLevel;
const id = (name: string) => `${kind}-${name}`;

const copy = {
  report: {
    title: t('formReportTitle'),
    intro: t('formReportIntro'),
    submit: t('formReportSubmit'),
  },
  consult: {
    title: t('formConsultTitle'),
    intro: t('formConsultIntro'),
    submit: t('formConsultSubmit'),
  },
  contact: {
    title: t('formContactTitle'),
    intro: t('formContactIntro'),
    submit: t('formContactSubmit'),
  },
}[kind];

const siteData = site(locale);
const productOptions = [
  ...products(locale).map((p) => ({ value: p.slug, label: p.name })),
  { value: 'free-vital', label: t('freeVital') },
];
const topicOptions = (
  [
    ['topicProductInfo', 'topicProductInfo'],
    ['topicScientific', 'topicScientific'],
    ['topicDistribution', 'topicDistribution'],
    ['topicOther', 'topicOther'],
  ] as const
).map(([value, key]) => ({ value, label: t(key) }));

const offline = t('formOffline')
  .replace('{phone}', siteData.phone)
  .replace('{email}', siteData.email);
const success = t('formSuccess');
const failure = t('formFailure').replace('{phone}', siteData.phone);
---

<form
  class="form"
  action="#"
  method="post"
  data-form={kind}
  data-endpoint={siteData.formEndpoint || undefined}
  data-offline-message={offline}
  data-success-message={success}
  data-error-message={failure}
  data-msg-sending={t('formSending')}
  data-msg-required={t('formErrRequired')}
  data-msg-email={t('formErrEmail')}
  data-msg-tel={t('formErrTel')}
  aria-labelledby={id('title')}
>
  <div class="form__head">
    <Heading class="form__title" id={id('title')}>{copy.title}</Heading>
    <p class="form__intro">{copy.intro}</p>
  </div>

  <div class="form__row">
    <Field id={id('name')} name="name" label={t('fieldName')} required autocomplete="name" optionalLabel={t('fieldOptional')} />
    <Field
      id={id('phone')}
      name="phone"
      label={t('fieldPhone')}
      type="tel"
      required
      autocomplete="tel"
      inputmode="tel"
      dir="ltr"
    />
  </div>

  {kind !== 'consult' && (
    <Field
      id={id('email')}
      name="email"
      label={t('fieldEmail')}
      type="email"
      autocomplete="email"
      inputmode="email"
      dir="ltr"
      optionalLabel={t('fieldOptional')}
    />
  )}

  {kind === 'report' && (
    <>
      <Field
        id={id('product')}
        name="product"
        label={t('fieldProductUsed')}
        as="select"
        required
        options={productOptions}
      />
      <Field id={id('detail')} name="detail" label={t('fieldAeDetail')} as="textarea" rows={3} />
    </>
  )}

  {kind === 'consult' && (
    <Field id={id('detail')} name="detail" label={t('fieldConsultDetail')} as="textarea" rows={4} />
  )}

  {kind === 'contact' && (
    <>
      <Field id={id('topic')} name="topic" label={t('fieldTopic')} as="select" required options={topicOptions} />
      <Field id={id('message')} name="message" label={t('fieldMessage')} as="textarea" rows={5} required />
    </>
  )}

  <div class="form__foot">
    <button class="btn btn--primary" type="submit">{copy.submit}</button>
  </div>
  <p class="form__status" data-form-status role="status" aria-live="polite"></p>
</form>

<script>
  import { initForms } from '../scripts/forms';
  initForms();
</script>
