---
import { nav, products, site } from '../data/site';
import type { Locale } from '../i18n/index';
import { makeT, withLocale } from '../i18n/index';
import Icon from './Icon.astro';
import Langs from './Langs.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
const siteData = site(locale);
const pages = nav(locale).filter((item) => !item.hasMenu);
---

<footer class="site-footer section--night">
  <div class="container site-footer__grid">
    <div class="site-footer__intro">
      <p class="site-footer__tagline">{siteData.tagline}</p>
      <p class="site-footer__claim">{siteData.claim}</p>
      <ul class="socials" aria-label={t('socialNetworks')}>
        <li><a class="chip" href={siteData.instagram} target="_blank" rel="noopener noreferrer">{siteData.instagramLabel}</a></li>
        <li><a class="chip" href={siteData.linkedin} target="_blank" rel="noopener noreferrer">{siteData.linkedinLabel}</a></li>
        <li><a class="chip" href={siteData.bale} target="_blank" rel="noopener noreferrer">{siteData.baleLabel}</a></li>
      </ul>
    </div>

    <nav aria-labelledby={`footer-quick-${locale}`}>
      <h2 class="site-footer__title" id={`footer-quick-${locale}`}>{t('quickAccess')}</h2>
      <ul class="site-footer__links">
        {pages.map((item) => <li><a href={withLocale(item.href, locale)}>{t(item.key)}</a></li>)}
        {products(locale).map((p) => (
          <li><a href={withLocale(`/products/${p.slug}`, locale)}>{p.name}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">{t('footerContactTitle')}</h2>
      <div class="site-footer__contact">
        <a class="site-footer__big" href={siteData.phoneHref}>
          <bdi dir="ltr">{siteData.phone}</bdi>
        </a>
        <a class="link" href={siteData.emailHref}>
          <Icon name="mail" />
          <bdi dir="ltr">{siteData.email}</bdi>
        </a>
        <address class="site-footer__addr">
          <span class="site-footer__label">{t('hqLabel')}</span>{siteData.hq}
          <a class="link" href={siteData.mapHq} target="_blank" rel="noopener noreferrer"><Icon name="pin" />{t('hqMapLink')}</a>
        </address>
        <address class="site-footer__addr">
          <span class="site-footer__label">{t('factoryLabel')}</span>{siteData.factory}
          <a class="link" href={siteData.mapFactory} target="_blank" rel="noopener noreferrer"><Icon name="pin" />{t('factoryMapLink')}</a>
        </address>
        <div>
          <a class="btn btn--ghost" href={siteData.patientPortal} target="_blank" rel="noopener noreferrer">
            {t('patientPortalLogin')}
            <Icon name="external" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- The last thing on every page: the word itself, breathing. Its weight
       inhales and exhales on the variable axis; decorative only. -->
  <p class="site-footer__word" aria-hidden="true">{t('heroWord')}</p>

  <div class="container site-footer__bottom">
    <p>{t('copyright')}</p>
    <Langs current={locale} />
  </div>
</footer>
