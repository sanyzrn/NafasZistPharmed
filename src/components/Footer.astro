---
import { nav, products, site } from '../data/site';
import Icon from './Icon.astro';
import Langs from './Langs.astro';
import Logo from './Logo.astro';

const pages = nav.filter((item) => !item.hasMenu);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="stack" style="--stack-gap: var(--sp-5)">
      <a class="brand" href="/" aria-label={`${site.name}، صفحه نخست`}>
        <Logo class="brand__mark" />
        <span class="brand__text">
          <span class="brand__name">{site.name}</span>
          <span class="brand__latin" lang="en" dir="ltr">{site.nameEn}</span>
        </span>
      </a>
      <div class="stack" style="--stack-gap: var(--sp-2)">
        <p class="site-footer__label">{site.tagline}</p>
        <p class="site-footer__claim">{site.claim}</p>
      </div>
      <ul class="socials" aria-label="شبکه‌های اجتماعی">
        <li><a class="link" href={site.instagram} target="_blank" rel="noopener noreferrer">اینستاگرام</a></li>
        <li><a class="link" href={site.linkedin} target="_blank" rel="noopener noreferrer">لینکدین</a></li>
        <li><a class="link" href={site.bale} target="_blank" rel="noopener noreferrer">بله</a></li>
      </ul>
    </div>

    <nav aria-labelledby="footer-quick">
      <h2 class="site-footer__title" id="footer-quick">دسترسی سریع</h2>
      <ul class="site-footer__links">
        {pages.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {products.map((p) => <li><a href={`/products/${p.slug}`}>{p.name}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">در تماس با نفس</h2>
      <div class="site-footer__contact">
        <div class="stack" style="--stack-gap: var(--sp-1)">
          <a class="link" href={site.phoneHref}>
            <Icon name="phone" />
            <bdi dir="ltr">{site.phone}</bdi>
          </a>
          <a class="link" href={site.emailHref}>
            <Icon name="mail" />
            <bdi dir="ltr">{site.email}</bdi>
          </a>
        </div>
        <address class="site-footer__addr">
          <span class="site-footer__label">دفتر مرکزی: </span>{site.hq}
          <br />
          <a class="link" href={site.mapHq} target="_blank" rel="noopener noreferrer">موقعیت دفتر مرکزی</a>
        </address>
        <address class="site-footer__addr">
          <span class="site-footer__label">کارخانه: </span>{site.factory}
          <br />
          <a class="link" href={site.mapFactory} target="_blank" rel="noopener noreferrer">موقعیت کارخانه</a>
        </address>
        <div>
          <a class="btn btn--quiet" href={site.patientPortal} target="_blank" rel="noopener noreferrer">
            ورود به پورتال بیماران
            <Icon name="external" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© کلیه حقوق این سایت متعلق به شرکت دانش‌بنیان نفس زیست فارمد است.</p>
    <Langs />
  </div>
</footer>
