---
/**
 * Inner page intro: an oversized title whose words rise in on load
 * (initSplit), and a thin lead. Text comes translated from the page.
 */
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="page-intro">
  <div class="container page-intro__inner">
    <h1 class="page-intro__title" data-split>{title}</h1>
    {lead && <p class="page-intro__lead">{lead}</p>}
    <slot />
  </div>
</section>
