---
import { products } from '../data/site';

const path = Astro.url.pathname;

const items = [
  { href: '/', label: 'خانه', match: (p: string) => p === '/' || p === '' },
  { href: '/#products', label: 'محصولات', match: (p: string) => p.startsWith('/products') },
  { href: '/about', label: 'درباره', match: (p: string) => p.startsWith('/about') },
  { href: '/contact', label: 'تماس', match: (p: string) => p.startsWith('/contact') },
];

const icons: Record<string, string> = {
  خانه: 'M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6',
  محصولات: 'M3 7h18v13H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18',
  درباره: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 21c1.5-4 4.5-6 8-6s6.5 2 8 6',
  تماس: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.8 2z',
};
---

<div class="bottom-sheet" id="bottom-sheet" data-open="false" role="dialog" aria-label="محصولات" aria-hidden="true">
  <div class="sheet-handle" aria-hidden="true"></div>
  <p class="sheet-title">محصولات نفس</p>
  <div class="sheet-grid">
    {products.map((p) => (
      <a href={`/products/${p.slug}`} data-sheet-link>
        <span class="sheet-name">{p.name}</span>
        <span class="sheet-cat">{p.category}</span>
      </a>
    ))}
  </div>
</div>
<div class="bottom-sheet-backdrop" id="sheet-backdrop" aria-hidden="true"></div>

<nav class="bottom-nav" aria-label="ناوبری موبایل">
  {items.map((item) => {
    const isProducts = item.label === 'محصولات';
    const active = !isProducts && item.match(path);
    return isProducts ? (
      <button type="button" class="bn-item" id="sheet-open" aria-haspopup="dialog">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[item.label]} /></svg>
        <span>{item.label}</span>
      </button>
    ) : (
      <a
        href={item.href}
        class:list={['bn-item', { active }]}
        aria-current={active ? 'page' : undefined}
      >
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[item.label]} /></svg>
        <span>{item.label}</span>
      </a>
    );
  })}
</nav>

<script>
  const sheet = document.getElementById('bottom-sheet');
  const backdrop = document.getElementById('sheet-backdrop');
  const openBtn = document.getElementById('sheet-open');

  const setSheet = (open: boolean) => {
    if (!sheet || !backdrop) return;
    sheet.dataset.open = open ? 'true' : 'false';
    sheet.setAttribute('aria-hidden', open ? 'false' : 'true');
    backdrop.dataset.open = open ? 'true' : 'false';
    document.body.style.overflow = open ? 'hidden' : '';
  };

  openBtn?.addEventListener('click', () => setSheet(sheet?.dataset.open !== 'true'));
  backdrop?.addEventListener('click', () => setSheet(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setSheet(false); });
  sheet?.querySelectorAll('[data-sheet-link]').forEach((a) => a.addEventListener('click', () => setSheet(false)));
</script>

<style>
  .bottom-nav {
    display: none;
  }

  .bottom-sheet,
  .bottom-sheet-backdrop {
    display: none;
  }

  @media (max-width: 640px) {
    .bottom-nav {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
      background: var(--white);
      border-top: 1px solid var(--line);
      padding: 0.4rem 0.5rem calc(0.4rem + env(safe-area-inset-bottom, 0px));
    }

    .bn-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.15rem;
      min-height: 54px;
      padding: 0.3rem 0.25rem;
      border: 0;
      background: transparent;
      color: var(--stone);
      font-size: 0.71rem;
      font-weight: 700;
      cursor: pointer;
      border-radius: var(--radius);
      font-family: inherit;
    }

    .bn-item.active {
      color: var(--brand);
    }

    .bn-item:focus-visible {
      outline: 2px solid var(--brand);
      outline-offset: 2px;
    }

    body {
      padding-bottom: calc(70px + env(safe-area-inset-bottom, 0px));
    }

    .bottom-sheet-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 74;
      background: rgba(31, 31, 29, 0.42);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .bottom-sheet-backdrop[data-open='true'] {
      opacity: 1;
      pointer-events: auto;
    }

    .bottom-sheet {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 75;
      background: var(--white);
      border-radius: 14px 14px 0 0;
      padding: 0.7rem 1.15rem calc(1.3rem + env(safe-area-inset-bottom, 0px));
      transform: translateY(110%);
      transition: transform 0.24s ease;
      box-shadow: 0 -16px 40px rgba(31, 31, 29, 0.18);
      max-height: 70vh;
      overflow: auto;
    }

    .bottom-sheet[data-open='true'] {
      transform: translateY(0);
    }

    .sheet-handle {
      width: 42px;
      height: 4px;
      border-radius: 999px;
      background: var(--mist);
      margin: 0.15rem auto 0.8rem;
    }

    .sheet-title {
      font-weight: 800;
      font-size: 1rem;
      color: var(--ink);
      margin-bottom: 0.8rem;
      text-align: center;
    }

    .sheet-grid {
      display: grid;
      gap: 0.5rem;
    }

    .sheet-grid a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      min-height: 50px;
      padding: 0.7rem 0.95rem;
      border-radius: var(--radius);
      background: var(--fog);
      font-weight: 700;
      color: var(--ink);
    }

    .sheet-grid a:active {
      background: color-mix(in srgb, var(--brand) 8%, white);
    }

    .sheet-cat {
      color: var(--brand);
      font-size: 0.76rem;
      font-weight: 800;
      background: color-mix(in srgb, var(--brand) 8%, white);
      padding: 0.18rem 0.55rem;
      border-radius: 999px;
    }
  }
</style>
