---
import { nav, products } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const icons = { '/': 'home', '/#products': 'box', '/about': 'person', '/contact': 'phone' } as const;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="bottom-bar" aria-label="ناوبری موبایل">
  {nav.map((item) =>
    item.hasMenu ? (
      <button
        class="bottom-bar__item"
        type="button"
        aria-expanded="false"
        aria-controls="product-sheet"
        data-sheet-open
      >
        <Icon name={icons[item.href as keyof typeof icons]} />
        {item.short}
      </button>
    ) : (
      <a class="bottom-bar__item" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        <Icon name={icons[item.href as keyof typeof icons]} />
        {item.short}
      </a>
    )
  )}
</nav>

<div class="sheet-backdrop" data-sheet-backdrop data-open="false"></div>
<div
  class="sheet"
  id="product-sheet"
  role="dialog"
  aria-modal="true"
  aria-labelledby="product-sheet-title"
  data-open="false"
>
  <div class="sheet__handle" aria-hidden="true"></div>
  <h2 class="sheet__title" id="product-sheet-title">محصولات نفس</h2>
  <ul class="sheet__list">
    {products.map((p) => (
      <li>
        <a class="sheet__link" href={`/products/${p.slug}`}>
          {p.name}
          <span class="sheet__cat">{p.category}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import { initProductSheet } from '../scripts/sheet';
  initProductSheet();
</script>
