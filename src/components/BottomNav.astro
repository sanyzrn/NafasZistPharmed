---
import { nav, products } from '../data/site';
import type { Locale } from '../i18n/index';
import { makeT, withLocale } from '../i18n/index';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const icons = { '/': 'home', '/#products': 'box', '/about': 'person', '/contact': 'phone' } as const;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path === `/${locale}` : path === href || path.startsWith(`${href}/`);
const items = nav(locale).map((item) => ({ ...item, href: withLocale(item.href, locale) }));
const sheetId = `product-sheet-${locale}`;
---

<nav class="bottom-bar" aria-label={t('mobileNav')}>
  {items.map((item) =>
    item.hasMenu ? (
      <button
        class="bottom-bar__item"
        type="button"
        aria-expanded="false"
        aria-controls={sheetId}
        data-sheet-open
      >
        <Icon name={icons[item.href as keyof typeof icons]} />
        {t(item.short)}
      </button>
    ) : (
      <a class="bottom-bar__item" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        <Icon name={icons[item.href as keyof typeof icons]} />
        {t(item.short)}
      </a>
    )
  )}
</nav>

<div class="sheet-backdrop" data-sheet-backdrop data-open="false"></div>
<div
  class="sheet"
  id={sheetId}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${sheetId}-title`}
  data-open="false"
>
  <div class="sheet__handle" aria-hidden="true"></div>
  <h2 class="sheet__title" id={`${sheetId}-title`}>{t('productsIndexTitle')}</h2>
  <ul class="sheet__list">
    {products(locale).map((p) => (
      <li>
        <a class="sheet__link" href={withLocale(`/products/${p.slug}`, locale)}>
          {p.name}
          <span class="sheet__cat">{t(`cat_${p.categoryKey}` as never)}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import { initProductSheet } from '../scripts/sheet';
  initProductSheet();
</script>
