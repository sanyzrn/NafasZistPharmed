---
import { nav, productCategories, products, site } from '../data/site';
import Icon from './Icon.astro';
import Langs from './Langs.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return path === '/';
  return path.startsWith(href);
};
const inProducts = path.startsWith('/products');
const latinOf = (slug: string) => products.find((p) => p.slug === slug)?.latinName;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label={`${site.name}، صفحه نخست`}>
      <Logo class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__latin" lang="en" dir="ltr">{site.nameEn}</span>
      </span>
    </a>

    <nav class="nav" aria-label="ناوبری اصلی">
      <ul class="nav__list">
        {nav.map((item) =>
          item.hasMenu ? (
            <li class="nav__item" data-menu>
              <button
                class="nav__link"
                type="button"
                aria-expanded="false"
                aria-controls="products-menu"
                data-current={inProducts ? 'true' : undefined}
              >
                {item.label}
                <Icon name="chevron" class="nav__chev" />
              </button>
              <div class="menu" id="products-menu" data-open="false">
                <div class="menu__grid">
                  {productCategories.map((cat) => (
                    <div>
                      <p class="menu__cat">{cat.key}</p>
                      <ul>
                        {cat.items.map((p) => (
                          <li>
                            <a class="menu__link" href={`/products/${p.slug}`}>
                              <span class="menu__name">{p.name}</span>
                              {latinOf(p.slug) && (
                                <span class="menu__latin" lang="en" dir="ltr">
                                  {latinOf(p.slug)}
                                </span>
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <a class="menu__all link" href="/#products">
                  فهرست کامل محصولات
                  <Icon name="arrow" />
                </a>
              </div>
            </li>
          ) : (
            <li class="nav__item">
              <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="header-phone" href={site.phoneHref}>
        <span class="sr-only">تلفن: </span>
        <bdi dir="ltr">{site.phone}</bdi>
      </a>
      <a class="btn btn--quiet portal-link" href={site.patientPortal} target="_blank" rel="noopener noreferrer">
        آموزش و حمایت بیمار
        <span class="sr-only">(در پنجره تازه باز می‌شود)</span>
      </a>
      <Langs />
    </div>
  </div>
</header>

<script>
  import { initProductMenu } from '../scripts/menu';
  initProductMenu();
</script>
