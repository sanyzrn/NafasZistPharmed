---
import { nav, productCategories, products, site } from '../data/site';
import type { Locale } from '../i18n/index';
import { makeT, withLocale } from '../i18n/index';
import Icon from './Icon.astro';
import Langs from './Langs.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
const siteData = site(locale);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  const home = withLocale('/', locale);
  if (href === home) return path === home || path === '/' || path === `/${locale}`;
  return path === href || path.startsWith(`${href}/`);
};
const inProducts = path.startsWith('/products') || path.startsWith(`/${locale}/products`);
const navItems = nav(locale).map((item) => ({
  ...item,
  href: withLocale(item.href, locale),
}));
const drawerId = `drawer-${locale}`;
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="brand" href={withLocale('/', locale)} aria-label={`${siteData.name}، ${t('home')}`}>
      <Logo class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{siteData.name}</span>
        <span class="brand__latin" lang="en" dir="ltr">{siteData.nameEn}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t('mainNav')}>
      <ul class="nav__list">
        {navItems.map((item) =>
          item.hasMenu ? (
            <li class="nav__item" data-menu>
              <button
                class="nav__link"
                type="button"
                aria-expanded="false"
                aria-controls="products-menu"
                data-current={inProducts ? 'true' : undefined}
              >
                {t('products')}
                <Icon name="chevron" class="nav__chev" />
              </button>
              <div class="menu" id="products-menu" data-open="false">
                <div class="menu__grid">
                  {productCategories(locale).map((cat) => (
                    <div class="menu__group">
                      <p class="menu__cat">{t(`cat_${cat.key}` as never)}</p>
                      <ul class="menu__list">
                        {cat.items.map((p) => (
                          <li>
                            <a class="menu__link" href={withLocale(`/products/${p.slug}`, locale)}>
                              <span class="menu__thumb">
                                <img src={p.image} alt="" width="96" height="96" loading="lazy" decoding="async" />
                              </span>
                              <span class="menu__text">
                                <span class="menu__name">{p.name}</span>
                                {p.latinName && (
                                  <span class="menu__latin" lang="en" dir="ltr">
                                    {p.latinName}
                                  </span>
                                )}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <a class="menu__all link" href={withLocale('/#products', locale)}>
                  {t('allProducts')}
                  <Icon name="arrow" />
                </a>
              </div>
            </li>
          ) : (
            <li class="nav__item">
              <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {t(item.key)}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="header-portal" href={siteData.patientPortal} target="_blank" rel="noopener noreferrer">
        {t('patientPortalCta')}
        <span class="sr-only">{t('inNewWindow')}</span>
      </a>
      <Langs current={locale} class="langs--header" />
      <ThemeToggle {locale} />
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls={drawerId}
        aria-label={t('menuOpen')}
        data-drawer-open
      >
        <span class="menu-btn__lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <span class="site-header__progress" aria-hidden="true"></span>
</header>

<dialog class="drawer" id={drawerId} data-drawer aria-label={t('mainNav')}>
  <div class="drawer__inner container">
    <div class="drawer__top">
      <span class="brand__name">{siteData.name}</span>
      <button class="drawer__close" type="button" data-drawer-close aria-label={t('menuClose')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <ul class="drawer__nav">
      {navItems.filter((item) => !item.hasMenu).map((item, i) => (
        <li style={`--i:${i}`}>
          <a class="drawer__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {t(item.key)}
          </a>
        </li>
      ))}
    </ul>
    <div class="drawer__products">
      <p class="drawer__label">{t('products')}</p>
      <ul class="drawer__plist">
        {products(locale).map((p, i) => (
          <li style={`--i:${i + 3}`}>
            <a href={withLocale(`/products/${p.slug}`, locale)}>
              <span>{p.name}</span>
              <span class="drawer__cat">{t(`cat_${p.categoryKey}` as never)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="drawer__foot">
      <a class="link" href={siteData.phoneHref}><Icon name="phone" /><bdi dir="ltr">{siteData.phone}</bdi></a>
      <a class="link" href={siteData.patientPortal} target="_blank" rel="noopener noreferrer">
        {t('patientPortalCta')}
        <Icon name="external" />
      </a>
      <Langs current={locale} />
    </div>
  </div>
</dialog>

<script>
  import { initProductMenu } from '../scripts/menu';
  initProductMenu();
</script>
