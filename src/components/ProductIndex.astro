---
/**
 * The product list rendered as a formulary index: grouped by therapeutic
 * category, one row per product. On the home page a filter lets clinicians
 * jump to a category without scrolling (real content, real sequence).
 */
import { productCategories } from '../data/site';
import type { Locale } from '../i18n/index';
import { makeT, withLocale } from '../i18n/index';
import Bidi from './Bidi.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  /** Limit to these slugs (keeps category grouping). Defaults to all. */
  only?: string[];
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** Shows the category filter chips (home page). */
  filter?: boolean;
}

const { locale, only, headingLevel = 'h3', filter = false } = Astro.props;
const t = makeT(locale);
const Heading = headingLevel;
const groups = productCategories(locale)
  .map((cat) => ({
    ...cat,
    items: only ? cat.items.filter((p) => only.includes(p.slug)) : cat.items,
  }))
  .filter((group) => group.items.length > 0);
const uid = `idx-${locale}-${only ? only.join('-') : 'all'}`;
---

<div class="index" data-index={uid}>
  {filter && groups.length > 1 && (
    <div class="index__filter" role="group" aria-label={t('filterAll')}>
      <button class="index__chip" type="button" data-filter="*" aria-pressed="true">{t('filterAll')}</button>
      {groups.map((group) => (
        <button
          class="index__chip"
          type="button"
          data-filter={group.key}
          aria-pressed="false"
        >
          {t(`cat_${group.key}` as never)}
        </button>
      ))}
    </div>
  )}

  {groups.map((group) => (
    <section class="index__group" data-group={group.key} aria-label={t(`cat_${group.key}` as never)}>
      <Heading class="index__cat">{t(`cat_${group.key}` as never)}</Heading>
      <ul class="index__rows">
        {group.items.map((p) => (
          <li>
            <a class="index__row" href={withLocale(`/products/${p.slug}`, locale)}>
              <span class="index__thumb">
                <img src={p.image} alt="" width="160" height="160" loading="lazy" decoding="async" />
              </span>
              <span class="index__main">
                <span class="index__name">
                  {p.name}
                  {p.latinName && (
                    <bdi class="index__latin" lang="en" dir="ltr">
                      {p.latinName}
                    </bdi>
                  )}
                </span>
                <span class="index__form">
                  <Bidi text={p.subtitle} />
                </span>
              </span>
              {p.genericLatin ? (
                <bdi class="index__generic" lang="en" dir="ltr">
                  {p.genericLatin}
                </bdi>
              ) : (
                <span class="index__generic"></span>
              )}
              <span class="index__go" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  /**
   * Category filter: chips toggle group visibility. No library, no reflow of
   * anything outside the index. aria-pressed carries the state.
   */
  document.querySelectorAll<HTMLElement>('[data-index]').forEach((index) => {
    if (!index.querySelector('[data-filter]')) return;
    const chips = Array.from(index.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const groups = Array.from(index.querySelectorAll<HTMLElement>('[data-group]'));
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter ?? '*';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        groups.forEach((group) => {
          group.hidden = key !== '*' && group.dataset.group !== key;
        });
      });
    });
  });
</script>
