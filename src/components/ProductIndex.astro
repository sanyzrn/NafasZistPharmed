---
/**
 * The product list rendered as a formulary index: grouped by therapeutic
 * category, one row per product with Persian name, Latin name, dosage form.
 */
import { productCategories, products, type Product } from '../data/site';
import Bidi from './Bidi.astro';
import Icon from './Icon.astro';

interface Props {
  /** Limit to these slugs (keeps category grouping). Defaults to all. */
  only?: string[];
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { only, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const bySlug = new Map(products.map((p) => [p.slug, p] as const));
const groups = productCategories
  .map((cat) => ({
    key: cat.key,
    items: cat.items
      .map((item) => bySlug.get(item.slug))
      .filter((p): p is Product => Boolean(p) && (!only || only.includes(p!.slug))),
  }))
  .filter((group) => group.items.length > 0);
---

<div class="index">
  {groups.map((group) => (
    <section class="index__group" aria-label={group.key}>
      <Heading class="index__cat">{group.key}</Heading>
      <ul class="index__rows">
        {group.items.map((p) => (
          <li>
            <a class="index__row" href={`/products/${p.slug}`}>
              <span class="index__thumb">
                <img src={p.image} alt="" width="160" height="160" loading="lazy" decoding="async" />
              </span>
              <span class="index__main">
                <span class="index__name">
                  {p.name}
                  {p.latinName && (
                    <bdi class="index__latin" lang="en" dir="ltr">
                      {p.latinName}
                    </bdi>
                  )}
                </span>
                <span class="index__form">
                  <Bidi text={p.subtitle} />
                </span>
              </span>
              {p.genericLatin ? (
                <bdi class="index__generic" lang="en" dir="ltr">
                  {p.genericLatin}
                </bdi>
              ) : (
                <span class="index__generic"></span>
              )}
              <span class="index__go" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
