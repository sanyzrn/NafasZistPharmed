---
/**
 * The product list as a formulary index: grouped by therapeutic category,
 * one large typographic row per product. On precise pointers a product
 * photo follows the cursor (src/scripts/interactions.ts → initPreview);
 * on touch screens each row shows its own thumbnail.
 * Product names carry a view-transition-name so they morph into the
 * product page title on navigation.
 */
import { productCategories } from '../data/site';
import type { Locale } from '../i18n/index';
import { makeT, withLocale } from '../i18n/index';
import Bidi from './Bidi.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  only?: string[];
  headingLevel?: 'h2' | 'h3' | 'h4';
  filter?: boolean;
  /** Give names a view-transition-name (only one list per page may). */
  morph?: boolean;
}

const { locale, only, headingLevel = 'h3', filter = false, morph = true } = Astro.props;
const t = makeT(locale);
const Heading = headingLevel;
const groups = productCategories(locale)
  .map((cat) => ({
    ...cat,
    items: only ? cat.items.filter((p) => only.includes(p.slug)) : cat.items,
  }))
  .filter((group) => group.items.length > 0);
const uid = `idx-${locale}-${only ? only.join('-') : 'all'}`;
---

<div class="index" data-index={uid} data-preview-list>
  {filter && groups.length > 1 && (
    <div class="index__filter" role="group" aria-label={t('filterAll')}>
      <button class="chip" type="button" data-filter="*" aria-pressed="true">{t('filterAll')}</button>
      {groups.map((group) => (
        <button class="chip" type="button" data-filter={group.key} aria-pressed="false">
          {t(`cat_${group.key}` as never)}
          <span class="chip__count">{group.items.length.toLocaleString(locale === 'fa' ? 'fa-IR' : locale)}</span>
        </button>
      ))}
    </div>
  )}

  {groups.map((group) => (
    <section class="index__group" data-group={group.key} aria-label={t(`cat_${group.key}` as never)}>
      <Heading class="index__cat">{t(`cat_${group.key}` as never)}</Heading>
      <ul class="index__rows">
        {group.items.map((p) => (
          <li>
            <a class="index__row" href={withLocale(`/products/${p.slug}`, locale)} data-preview={p.image}>
              <span class="index__thumb">
                <img src={p.image} alt="" width="160" height="160" loading="lazy" decoding="async" />
              </span>
              <span class="index__main">
                <span class="index__name" style={morph ? `view-transition-name: name-${p.slug}` : undefined}>
                  {p.name}
                </span>
                <span class="index__form">
                  <Bidi text={p.subtitle} />
                </span>
              </span>
              <span class="index__meta">
                {p.latinName && (
                  <bdi class="index__latin" lang="en" dir="ltr">
                    {p.latinName}
                  </bdi>
                )}
                {p.genericLatin && (
                  <bdi class="index__generic" lang="en" dir="ltr">
                    {p.genericLatin}
                  </bdi>
                )}
              </span>
              <span class="index__go" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  /** Category filter: chips toggle group visibility; aria-pressed carries state. */
  document.querySelectorAll<HTMLElement>('[data-index]').forEach((index) => {
    if (!index.querySelector('[data-filter]')) return;
    const chips = Array.from(index.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const groups = Array.from(index.querySelectorAll<HTMLElement>('[data-group]'));
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter ?? '*';
        const apply = () => {
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          groups.forEach((group) => {
            group.hidden = key !== '*' && group.dataset.group !== key;
          });
        };
        // same-document view transition: rows slide into their new places
        const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (doc.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          doc.startViewTransition(apply);
        } else apply();
      });
    });
  });
</script>
