---
/**
 * The signature visual: the two "breath" arcs of the logo mark, repeated
 * outward like a slow exhale spreading into still air. Pure SVG, no raster.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const CX = 500;
const BASE = 660;
// Same curve family as the logo arc: M(cx-w,base) c w/3,-11h/15 2w/3,-h w,-h s 2w/3,4h/15 w,h
const arc = (w: number, h: number) =>
  `M${CX - w} ${BASE}c${(w / 3).toFixed(1)} ${(-11 * h / 15).toFixed(1)} ${(2 * w / 3).toFixed(1)} ${(-h).toFixed(1)} ${w} ${(-h).toFixed(1)}s${(2 * w / 3).toFixed(1)} ${(4 * h / 15).toFixed(1)} ${w} ${h.toFixed(1)}`;

const widths = [70, 125, 195, 280, 380, 495, 625];
const arcs = widths.map((w, i) => {
  const h = w * (1.25 - i * 0.035);
  const o = 0.62 - i * 0.075;
  const sw = 2.4 - i * 0.22;
  return { d: arc(w, h), o: o.toFixed(2), sw: sw.toFixed(2), i };
});
const dotY = BASE - (widths[0] * 1.25 + widths[1] * (1.25 - 0.035)) / 2;
const uid = 'bf';
---

<svg
  class={`breath ${className}`.trim()}
  viewBox="0 0 1000 700"
  preserveAspectRatio="xMidYMax meet"
  aria-hidden="true"
  focusable="false"
  overflow="visible"
>
  <defs>
    <radialGradient id={`${uid}-glow`} cx="50%" cy="80%" r="55%">
      <stop offset="0" stop-color="#B61615" stop-opacity="0.16" />
      <stop offset="0.45" stop-color="#B61615" stop-opacity="0.06" />
      <stop offset="1" stop-color="#B61615" stop-opacity="0" />
    </radialGradient>
  </defs>
  <ellipse class="breath__glow" cx={CX} cy={BASE - 120} rx="560" ry="460" fill={`url(#${uid}-glow)`} />
  {arcs.map((a) => (
    <path
      class="breath__arc"
      d={a.d}
      stroke-width={a.sw}
      opacity={a.o}
      style={`--i:${a.i};--o:${a.o}`}
      vector-effect="non-scaling-stroke"
    />
  ))}
  <circle class="breath__dot" cx={CX} cy={dotY.toFixed(1)} r="9" opacity="0.85" />
</svg>
