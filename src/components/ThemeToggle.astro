---
/**
 * Theme switch: a liquid knob (goo filter) that stretches as it crosses the
 * track, like the reference toggle. Light ↔ dark; the explicit choice is
 * stored in localStorage (nzp-theme). Until someone flips it, the site
 * follows the system theme. Labels come from the locale dictionary.
 */
import type { Locale } from '../i18n/index';
import { makeT } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
---

<button
  class="switch"
  type="button"
  role="switch"
  aria-checked="false"
  data-theme-toggle
  aria-label={t('themeDark')}
  data-label-light={t('themeLight')}
  data-label-dark={t('themeDark')}
  data-label-system={t('themeSystem')}
>
  <span class="liquid switch__liquid" aria-hidden="true">
    <span class="switch__knob"></span>
    <span class="switch__tail"></span>
  </span>
  <svg class="switch__icon switch__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6" />
  </svg>
  <svg class="switch__icon switch__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
  </svg>
  <span class="sr-only" data-theme-status role="status" aria-live="polite"></span>
</button>

<script>
  import { initThemeToggle } from '../scripts/theme';
  initThemeToggle();
</script>
