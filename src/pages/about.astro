---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';

const values = [
  {
    title: 'شجاعت',
    body: 'جسارت در نوآوری، پذیرش مسئولیت، ریسک‌پذیری هوشمندانه، و یادگیری از تجربیات.',
  },
  {
    title: 'کار تیمی',
    body: 'تلاش بی‌وقفه برای ارتقای زندگی انسان‌ها از طریق هم‌افزایی و همدلی.',
  },
  {
    title: 'احترام',
    body: 'پذیرش تنوع و نیازهای متنوع جامعه با رویکردی همدلانه.',
  },
  {
    title: 'یکپارچگی',
    body: 'فعالیت با صداقت و شفافیت کامل، پایبندی به بالاترین استانداردهای اخلاقی و کیفی.',
  },
];

// "Title: description" pairs; split so the title can carry the hierarchy.
const missions = [
  'تولید داروهای پیشرفته: توسعه و تولید داروهای استنشاقی و نانوداروها با فناوری‌های پیشرفته و دانش فنی بومی.',
  'نوآوری و همکاری علمی: ارائه محصولات خلاقانه با نظام‌های مدیریتی نوین و ارتباط با مراکز دانشگاهی داخلی و بین‌المللی.',
  'افزایش دسترسی و کیفیت: ارتقای سطح کیفیت محصولات و تسهیل دسترسی تمامی اقشار جامعه.',
  'خلق ارزش پایدار: ایجاد ارزش مداوم برای تمامی ذی‌نفعان از طریق نیروی انسانی متعهد و کارآمد.',
].map((m) => {
  const [title, ...rest] = m.split(':');
  return { title: title.trim(), body: rest.join(':').trim() };
});

const gallery = [
  'https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas5.jpg',
  'https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas6.jpg',
  'https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas7.jpg',
  'https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas9.jpg',
  'https://nafaspharmed.com/up/wp-content/uploads/2025/01/20250113_104838.jpg',
  'https://nafaspharmed.com/up/wp-content/uploads/2025/10/IMG_0749.jpg',
];
const faDigits = (n: number) => n.toLocaleString('fa-IR');
---

<Base title="درباره نفس" description="درباره شرکت دانش‌بنیان نفس زیست فارمد — از پژوهش تا تولید.">
  <PageIntro title="درباره نفس" lead="از پژوهش تا تولید؛ همراه با دانش، مسئولیت و تعهد به سلامت." />

  <section class="section" id="nafas-story" aria-labelledby="story-title">
    <div class="container split">
      <div class="stack" style="--stack-gap: var(--sp-5)">
        <h2 class="heading__title" id="story-title">نفس، از آغاز تا امروز</h2>
        <p class="year"><span class="year__value">۱۳۹۸</span> آغاز یک مسیر</p>
        <div class="prose">
          <p>
            شرکت دانش‌بنیان نفس زیست فارمد در سال ۱۳۹۸ با هدف پاسخ به نیاز بیماران و دستیابی به جایگاهی پیشرو در صنعت
            تولید دارو آغاز به کار نمود. از نخستین روزها، تمرکز بر محصولات استنشاقی پودری (<bdi lang="en">DPI</bdi>) قرار
            گرفت.
          </p>
          <p>
            پس از سال‌ها تحقیق و توسعه، دانش فنی فرمولاسیون دارویی و مهندسی آیرودینامیک ذرات به دست آمد و مجوز تولید نخستین
            محصول از سوی سازمان غذا و دارو صادر شد. محصول <a class="link" href="/products/tio-toriva">تیوتوریوا</a>
            (تیوتروپیوم ۱۸ میکروگرم) به عنوان اولین محصول استنشاقی پودری تولید انبوه در ایران معرفی شد.
          </p>
          <p>
            این شرکت به پشتوانه این موفقیت، تأییدیه «دانش‌بنیان نوع یک» از معاونت علمی و فناوری ریاست جمهوری را دریافت کرده
            است. تولید تیوتوریوا نه‌تنها از خروج سالانه بیش از ۱۰ میلیون دلار ارز جلوگیری می‌کند، بلکه افق صادرات به کشورهای
            همسایه را نیز گشوده است.
          </p>
        </div>
      </div>
      <div class="stack" style="--stack-gap: var(--sp-5)">
        <figure class="media media--wide">
          <img
            src="https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas6.jpg"
            alt="شرکت نفس زیست فارمد"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <dl class="facts">
          <div class="facts__item">
            <dt class="facts__term">سال تأسیس</dt>
            <dd class="facts__value">۱۳۹۸</dd>
          </div>
          <div class="facts__item">
            <dt class="facts__term">دانش‌بنیان</dt>
            <dd class="facts__value">نوع ۱</dd>
          </div>
          <div class="facts__item">
            <dt class="facts__term">تخصص اصلی</dt>
            <dd class="facts__value"><bdi lang="en">DPI</bdi></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--air" aria-labelledby="mission-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="mission-title">رسالت ما</h2>
        <p class="heading__lead">
          شرکت دانش‌بنیان نفس زیست فارمد با چشم‌اندازی روشن در مسیر ارتقای سلامت جامعه و تعهد به حفظ محیط زیست،
          مأموریت‌های زیر را در اولویت قرار داده است:
        </p>
      </div>
      <dl class="defs defs--two">
        {missions.map((m) => (
          <div class="defs__row">
            <dt class="defs__term">{m.title}</dt>
            <dd class="defs__desc">{m.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="values-title">
    <div class="container split">
      <div class="heading">
        <h2 class="heading__title" id="values-title">ارزش‌های نفس</h2>
        <p class="heading__lead">اصول مشترک ما</p>
      </div>
      <dl class="defs">
        {values.map((v) => (
          <div class="defs__row">
            <dt class="defs__term">{v.title}</dt>
            <dd class="defs__desc">{v.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--flush-top" aria-labelledby="gallery-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="gallery-title">روایت تصویری نفس</h2>
      </div>
      <ul class="gallery">
        {gallery.map((src, i) => (
          <li class="gallery__item">
            <img
              src={src}
              alt={`گالری نفس زیست فارمد، تصویر ${faDigits(i + 1)} از ${faDigits(gallery.length)}`}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--air" aria-labelledby="jobs-title">
    <div class="container split split--center">
      <div class="stack" style="--stack-gap: var(--sp-5)">
        <h2 class="heading__title" id="jobs-title">با هم برای آینده‌ای سالم و روشن</h2>
        <p class="prose prose--muted">
          در نفس زیست فارمد، کیفیت، صداقت، مسئولیت‌پذیری و پویایی، سنگ‌بنای حرکت رو به جلوست. پیوستن به تیم نفس، فرصتی
          منحصربه‌فرد برای رشد حرفه‌ای و توسعه مهارت‌های شماست.
        </p>
        <div>
          <a class="btn btn--primary" href={site.jobs} target="_blank" rel="noopener noreferrer">
            ارسال رزومه
            <Icon name="external" />
          </a>
        </div>
      </div>
      <blockquote class="quote">
        <p>«ما در نفس، نه فقط به دنبال همکار، بلکه به دنبال همراهی برای رشد و تحول هستیم.»</p>
      </blockquote>
    </div>
  </section>
</Base>
