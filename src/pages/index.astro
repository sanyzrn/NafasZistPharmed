---
import Base from '../layouts/Base.astro';
import BreathField from '../components/BreathField.astro';
import Icon from '../components/Icon.astro';
import ProductIndex from '../components/ProductIndex.astro';
import SiteForm from '../components/SiteForm.astro';
import { news, site } from '../data/site';
---

<Base
  title="صفحه نخست"
  description="نفس زیست فارمد — مراقب شما، در هر نفس. شرکت دانش‌بنیان توسعه داروهای استنشاقی."
>
  <section class="hero" aria-labelledby="hero-title">
    <BreathField />
    <div class="container hero__inner">
      <h1 class="hero__title" id="hero-title">{site.tagline}</h1>
      <p class="hero__lead">
        نفس زیست فارمد از سال ۱۳۹۸ با تمرکز بر داروهای استنشاقی، برای پاسخ به نیاز بیماران و ارتقای کیفیت زندگی تلاش
        می‌کند.
      </p>
      <div class="actions hero__actions">
        <a class="btn btn--primary" href="#products">
          محصولات نفس
          <Icon name="arrow" />
        </a>
        <a class="btn btn--quiet" href="/about">درباره نفس</a>
      </div>
      <dl class="facts">
        <div class="facts__item">
          <dt class="facts__term">سال تأسیس</dt>
          <dd class="facts__value">۱۳۹۸</dd>
        </div>
        <div class="facts__item">
          <dt class="facts__term">دانش‌بنیان</dt>
          <dd class="facts__value">نوع ۱</dd>
        </div>
        <div class="facts__item">
          <dt class="facts__term">تخصص اصلی</dt>
          <dd class="facts__value"><bdi lang="en">DPI</bdi></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--flush-top" id="products" aria-labelledby="products-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="products-title">محصولات نفس</h2>
        <p class="heading__lead">
          فهرست فرآورده‌ها بر اساس گروه درمانی. برای دیدن شکل فرآورده، نحوه مصرف و کاتالوگ، روی هر محصول بزنید.
        </p>
      </div>
      <ProductIndex />
    </div>
  </section>

  <section class="section section--air" aria-labelledby="about-title">
    <div class="container split split--center">
      <div class="stack" style="--stack-gap: var(--sp-5)">
        <h2 class="heading__title" id="about-title">از پژوهش تا تولید، در کنار شما</h2>
        <p class="prose prose--muted">
          نخستین محصول استنشاقی پودری تولید انبوه در ایران با دانش فنی بومی؛ از آزمایشگاه تا بیمار، با یک تعهد: رساندن
          دوز کامل درمان به کسی که به آن نیاز دارد.
        </p>
        <div>
          <a class="link" href="/about">
            بیشتر درباره نفس
            <Icon name="arrow" />
          </a>
        </div>
      </div>
      <figure class="media media--wide">
        <img
          src="https://nafaspharmed.com/up/wp-content/uploads/2024/03/nafas6-1024x683.jpg"
          alt="تیم و فضای شرکت نفس زیست فارمد"
          width="1024"
          height="683"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="news-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="news-title">دانش و رویدادها</h2>
      </div>
      <ul class="news">
        {news.map((n) => (
          <li>
            <a class="news__row" href={n.href} target="_blank" rel="noopener noreferrer">
              <span class="news__thumb">
                <img src={n.image} alt="" width="240" height="180" loading="lazy" decoding="async" />
              </span>
              <span class="news__main">
                <span class="news__date">{n.date}</span>
                <span class="news__title">{n.title}</span>
              </span>
              <span class="news__ext">
                <Icon name="external" label="در پنجره تازه باز می‌شود" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--flush-top" aria-label="بیماران و فرصت‌های شغلی">
    <div class="container pathways">
      <div class="pathways__item">
        <h2 class="pathways__title">آگاهی بیشتر، همراهی نزدیک‌تر</h2>
        <p class="pathways__text">
          کاتالوگ‌ها، بروشورها و ویدئوهای آموزشی محصولات نفس را در پورتال حمایت بیمار ببینید.
        </p>
        <a class="btn btn--quiet" href={site.patientPortal} target="_blank" rel="noopener noreferrer">
          ورود به پورتال بیماران
          <Icon name="external" />
        </a>
      </div>
      <div class="pathways__item">
        <h2 class="pathways__title">با هم برای آینده‌ای سالم و روشن</h2>
        <p class="pathways__text">
          به تیم نفس بپیوندید؛ جایی برای رشد حرفه‌ای و همراهی در مسیر سلامت جامعه.
        </p>
        <a class="btn btn--quiet" href={site.jobs} target="_blank" rel="noopener noreferrer">
          مشاهده فرصت‌های شغلی
          <Icon name="external" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--air" aria-labelledby="forms-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="forms-title">گزارش و مشاوره</h2>
        <p class="heading__lead">
          عارضه‌ای را پس از مصرف محصولات نفس دیده‌اید یا پرسشی دارید؟ فرم مربوط را پر کنید.
        </p>
      </div>
      <div class="forms">
        <SiteForm kind="report" headingLevel="h3" />
        <SiteForm kind="consult" headingLevel="h3" />
      </div>
    </div>
  </section>
</Base>
