---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import SiteForm from '../components/SiteForm.astro';
import { site } from '../data/site';
---

<Base title="تماس با نفس" description="ارتباط با نفس زیست فارمد — تماس، نشانی‌ها و فرم پیام.">
  <PageIntro
    title="تماس با نفس"
    lead="ارتباط فقط یک تماس نیست؛ شروع یک همکاری علمی، درمانی و حرفه‌ای است."
  />

  <section class="section" aria-labelledby="direct-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="direct-title">صدای شما را می‌شنویم</h2>
        <p class="heading__lead">
          در نفس زیست فارمد باور داریم ارتباط مؤثر، پایه‌گذار همکاری‌های ماندگار است. تیم ما آماده پاسخگویی به پزشکان،
          داروسازان، مراکز درمانی، شرکت‌های پخش و تمامی همکاران تجاری در سریع‌ترین زمان ممکن است.
        </p>
      </div>
      <div class="direct">
        <a class="direct__item" href={site.phoneHref}>
          <span class="direct__label">تلفن</span>
          <bdi class="direct__value" dir="ltr">{site.phone}</bdi>
        </a>
        <a class="direct__item" href={site.emailHref}>
          <span class="direct__label">ایمیل</span>
          <bdi class="direct__value" dir="ltr">{site.email}</bdi>
        </a>
      </div>
      <p class="heading__lead">برای پرسش درباره محصولات، همکاری‌های علمی و امور توزیع با ما در تماس باشید.</p>
    </div>
  </section>

  <section class="section section--air" aria-labelledby="places-title">
    <div class="container section-body">
      <div class="heading">
        <h2 class="heading__title" id="places-title">دو نشانی، یک مسیر مشترک</h2>
      </div>
      <div class="places">
        <div class="place">
          <h3 class="place__title">دفتر مرکزی</h3>
          <address class="place__addr">{site.hq}</address>
          <a class="btn btn--quiet" href={site.mapHq} target="_blank" rel="noopener noreferrer">
            <Icon name="pin" />
            مسیریابی دفتر مرکزی
          </a>
        </div>
        <div class="place">
          <h3 class="place__title">کارخانه</h3>
          <address class="place__addr">{site.factory}</address>
          <a class="btn btn--quiet" href={site.mapFactory} target="_blank" rel="noopener noreferrer">
            <Icon name="pin" />
            مسیریابی کارخانه
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-label="گفت‌وگو با نفس">
    <div class="container split">
      <div class="stack" style="--stack-gap: var(--sp-7)">
        <div class="stack" style="--stack-gap: var(--sp-3)">
          <h2 class="pathways__title">راه‌های دیگر ارتباط</h2>
          <p class="pathways__text">تازه‌های نفس را در شبکه‌های اجتماعی دنبال کنید.</p>
          <ul class="socials">
            <li><a class="link" href={site.instagram} target="_blank" rel="noopener noreferrer">اینستاگرام</a></li>
            <li><a class="link" href={site.linkedin} target="_blank" rel="noopener noreferrer">لینکدین</a></li>
            <li><a class="link" href={site.bale} target="_blank" rel="noopener noreferrer">بله</a></li>
          </ul>
        </div>
        <div class="stack" style="--stack-gap: var(--sp-3)">
          <h2 class="pathways__title">همکاری با نفس</h2>
          <p class="pathways__text">برای پیوستن به تیم نفس، رزومه خود را ارسال کنید.</p>
          <div>
            <a class="btn btn--quiet" href={site.jobs} target="_blank" rel="noopener noreferrer">
              ارسال رزومه
              <Icon name="external" />
            </a>
          </div>
        </div>
      </div>
      <SiteForm kind="contact" />
    </div>
  </section>
</Base>
