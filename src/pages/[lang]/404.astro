---
import NotFoundContent from '../../templates/NotFound.astro';
import type { Locale } from '../../i18n/index';

export function getStaticPaths() {
  return (['ar', 'en', 'ru'] as const).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<NotFoundContent locale={lang as Locale} />
