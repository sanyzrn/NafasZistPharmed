---
import ContactContent from '../../templates/Contact.astro';
import type { Locale } from '../../i18n/index';

export function getStaticPaths() {
  return (['ar', 'en', 'ru'] as const).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<ContactContent locale={lang as Locale} />
